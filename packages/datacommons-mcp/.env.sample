# Data Commons MCP Server Configuration
# 
# This file contains all available configuration options for the Data Commons MCP server.
# To use this configuration:
# 1. Copy this file to .env: cp .env.sample .env
# 2. Edit .env with your actual values
# 3. Uncomment and set the variables you need
#
# Environment variables take precedence over .env file values.

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# API key for Data Commons (required for production API)
DC_API_KEY=your_datacommons_api_key_here

# =============================================================================
# COMMONLY USED OPTIONAL CONFIGURATION
# =============================================================================

# Root URL for Data Commons Agent API endpoints (optional)
# Defaults to production: https://api.datacommons.org/v2
# DC_AGENT_API_ROOT=https://api.datacommons.org/v2

# Search scope for queries (optional, e.g. for DCP instances)
# Options: "custom_only", "base_only", "base_and_custom"
# DC_SEARCH_SCOPE=custom_only

# Path to directory containing markdown file overrides for server instructions and/or tool descriptions.
# Supports partial overrides: only create files for the specific instructions or tools you want to replace. 
# The system will fall back to package defaults for any file not found here.
# Supports both local filesystem paths and Google Cloud Storage paths (e.g., gs://bucket/path).
#
# Expected structure inside this directory:
# - server.md
# - tools/{tool_name}.md
# - skills/{skill_name}/SKILL.md
# DC_INSTRUCTIONS_DIR=/path/to/custom/instructions

# =============================================================================
# NON-PROD / LOCAL ROOTS (optional)
# =============================================================================

# Root URL for Data Commons API key validation (optional)
# Configure for non-prod environments if validating keys against non-prod mixer
# DC_API_KEY_VALIDATION_ROOT=https://api.datacommons.org
